# CPU frequency scaling, divider-only (added 2026-08-09).
#
# The boot loader leaves PLL_SCPU at 1201.5 MHz with the post-divider at /2,
# so the four A53 cores have always run at 600.75 MHz - on the vendor 4.9
# kernel too (WD never enabled DVFS on this board; the "always full speed"
# audit note was wrong in the other direction). The new clk-rtd129x-scpu
# driver switches only that post-divider (/2 <-> /4, verified live on the
# running board before the driver was written), so the idle clock drops to
# 300.375 MHz while the cpudvs voltage rail is never touched and the proven
# 600.75 MHz operating point remains the maximum.
#
# cpufreq-dt binds automatically (cpu0 carries operating-points-v2);
# schedutil is the default governor.
CONFIG_COMMON_CLK_RTD129X_SCPU=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y

# The DTS has described crt/iso/sb2/misc as syscon nodes since the initial
# port, but nothing consumed them until clk-rtd129x-scpu - and without
# MFD_SYSCON the syscon_node_to_regmap() header stub returns -ENOTSUPP
# (found on first r6 boot: probe failed, cpufreq-dt deferred forever).
CONFIG_MFD_SYSCON=y

# Peak OPP guardrail (added with the 1100 MHz point): the SoC sensor
# throttles the CPU through the cpufreq cooling device at the 85C
# passive trip, long before the 105C critical trip.
CONFIG_CPU_THERMAL=y
