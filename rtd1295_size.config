# Optimize for size
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=n
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable debug features
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_FTRACE=n
CONFIG_PROFILING=n
CONFIG_KALLSYMS=n
CONFIG_KALLSYMS_ALL=n
CONFIG_TRACING=n
CONFIG_PRINTK_TIME=n
CONFIG_DYNAMIC_DEBUG=n
CONFIG_MAGIC_SYSRQ=n

# Disable unneeded features
CONFIG_NET_CORE=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_HID_SUPPORT=n
CONFIG_USB_SUPPORT=y
