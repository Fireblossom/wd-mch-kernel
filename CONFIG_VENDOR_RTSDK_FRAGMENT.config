# Minimal config fragment for WD My Cloud Home (RTD1295) bring-up, route-B (vendor drivers)
#
# Apply on top of an arm64 defconfig:
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m .config CONFIG_VENDOR_RTSDK_FRAGMENT.config
#   make ARCH=arm64 olddefconfig
#
# Core buses / PMIC
CONFIG_I2C=y
CONFIG_I2C_RTK=m
CONFIG_MFD_CORE=y
CONFIG_MFD_G2227_I2C=m
CONFIG_REGULATOR=y
CONFIG_REGULATOR_G2227=m
#
# IRQ mux for vendor interrupt-parent = <&mux_intc>
CONFIG_IRQ_RTD129X_MUX=y
#
# Vendor reserved-memory remap helper for "rsvmem-remap"
# (must be built-in for RESERVEDMEM_OF_DECLARE() to run)
CONFIG_RTK_RSVMEM_REMAP=y

# SATA (generic AHCI + vendor SATA PHY)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_AHCI_PLATFORM=y
CONFIG_PHY_RTK_RTD_SATAPHY=y