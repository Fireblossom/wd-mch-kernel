# Front SYS LED (added 2026-08-09): vendor-port PWM driver (channel 3 =
# the LED) + leds-pwm + the useful triggers. /sys/class/leds/white:sys.
CONFIG_PWM=y
CONFIG_PWM_RTD129X=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DISK=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
