# Crash-log persistence and serial-free kernel testing (added 2026-08-09).
#
# PSTORE_RAM binds to the ramoops@22000000 reserved region already present in
# rtd1295-wd-mycloud-home.dts (2 MiB, compatible = ramoops). Until this was
# enabled the region was reserved but unusable, so a spontaneous reboot left no
# record across the reset. With it, the previous boot's dmesg tail survives in
# /sys/fs/pstore.
#
# KEXEC lets a validated kernel be test-booted with `kexec -e` without writing
# flash, which matters on this board because the only other way to try a kernel
# is a serial + U-Boot + TFTP flash of the B slot.
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFLATE_COMPRESSION=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_KEXEC=y
