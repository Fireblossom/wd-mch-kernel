# Built-in bring-up config fragment for WD My Cloud Home (RTD1295), route-B.
#
# Rationale:
# - IRQ mux must be available early for vendor interrupt routing.
# - I2C + PMIC as built-in avoids “module ordering” problems during early boot.
# - rsvmem-remap helper must be built-in (RESERVEDMEM_OF_DECLARE).
#
CONFIG_I2C=y
CONFIG_I2C_RTK=y

CONFIG_MFD_CORE=y
CONFIG_MFD_G2227_I2C=y

CONFIG_REGULATOR=y
CONFIG_REGULATOR_G2227=y

CONFIG_IRQ_RTD129X_MUX=y
CONFIG_RTK_RSVMEM_REMAP=y

# SATA (generic AHCI + vendor SATA PHY)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_AHCI_PLATFORM=y
CONFIG_PHY_RTK_RTD_SATAPHY=y

# GMAC — RTD1295 SoC-internal Gigabit Ethernet (vendor r8169soc platform driver)
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169SOC=y
CONFIG_ARCH_RTD129x=y
